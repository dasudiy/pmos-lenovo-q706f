# Reference: <https://postmarketos.org/devicepkg>
# Maintainer: chalkin Deng <chalkin@yeah.net>
pkgname=device-lenovo-q706f
pkgdesc="Lenovo Xiaoxin Pad Pro 12.6 (Lenovo Tab P12 Pro)"
pkgver=8
pkgrel=3
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	alsa-ucm-conf
	bootmac
	hexagonrpcd>=0.3.2-r3
	linux-postmarketos-qcom-sm8250
	make-dynpart-mappings
	mesa-vulkan-freedreno
	mkbootimg
	postmarketos-base
	qbootctl
	swclock-offset
"
makedepends="devicepkg-dev"
install="
	$pkgname-nonfree-firmware-openrc.post-install
	$pkgname-nonfree-firmware-openrc.post-upgrade
	$pkgname-openrc.post-install
	$pkgname-openrc.post-upgrade
	"
source="
	81-libssc-lenovo-q706f.rules
	90-swclock-offset-rtc.rules
	alsa-ucm-conf/q706f.conf
	alsa-ucm-conf/HiFi.conf
	deviceinfo
	kernel-cmdline.conf
	hexagonrpcd.confd
	modules-initfs
	q706f-audio-blank.desktop
	q706f-audio-blank.service
	q706f-audio-blank.sh
	q706f-suspend-audio.conf
	q706f-suspend-audio.sh
	swclock-offset-boot-wait-rtc.conf
"

subpackages="
	$pkgname-nonfree-firmware:nonfree_firmware
	$pkgname-nonfree-firmware-openrc:nonfree_firmware_openrc
	$pkgname-openrc
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
	# device-specific alsa ucm conf
	install -Dm644 "$srcdir/q706f.conf" \
		"$pkgdir/usr/share/alsa/ucm2/Lenovo/q706f/q706f.conf"

	install -Dm644 "$srcdir/HiFi.conf" \
		"$pkgdir/usr/share/alsa/ucm2/Lenovo/q706f/HiFi.conf"

	mkdir -p "$pkgdir/usr/share/alsa/ucm2/conf.d/sm8250"
	ln -s ../../Lenovo/q706f/q706f.conf \
		"$pkgdir/usr/share/alsa/ucm2/conf.d/sm8250/Xiaoxin Pad Pro.conf"

	install -Dm644 "$srcdir"/81-libssc-lenovo-q706f.rules \
		"$pkgdir"/usr/lib/udev/rules.d/81-libssc-lenovo-q706f.rules

	install -Dm644 "$srcdir"/90-swclock-offset-rtc.rules \
		"$pkgdir"/usr/lib/udev/rules.d/90-swclock-offset-rtc.rules

	install -Dm644 "$srcdir"/hexagonrpcd.confd \
		"$pkgdir"/usr/share/hexagonrpcd/hexagonrpcd-sdsp.conf

	# Forward-compatible cmdline drop-in (devicepkg >=0.19 installs this
	# automatically; keep an explicit install for older devicepkg).
	install -Dm644 "$srcdir"/kernel-cmdline.conf \
		"$pkgdir"/usr/lib/kernel-cmdline.d/50-$pkgname.conf

	install -Dm644 "$srcdir"/swclock-offset-boot-wait-rtc.conf \
		"$pkgdir"/usr/lib/systemd/system/swclock-offset-boot.service.d/wait-rtc.conf

	install -Dm755 "$srcdir"/q706f-suspend-audio.sh \
		"$pkgdir"/usr/lib/device-lenovo-q706f/q706f-suspend-audio.sh
	install -Dm644 "$srcdir"/q706f-suspend-audio.conf \
		"$pkgdir"/usr/lib/systemd/system/systemd-suspend.service.d/q706f-audio.conf
	install -Dm755 "$srcdir"/q706f-audio-blank.sh \
		"$pkgdir"/usr/lib/device-lenovo-q706f/q706f-audio-blank.sh
	install -Dm644 "$srcdir"/q706f-audio-blank.desktop \
		"$pkgdir"/etc/xdg/autostart/q706f-audio-blank.desktop
	install -Dm644 "$srcdir"/q706f-audio-blank.service \
		"$pkgdir"/usr/lib/systemd/user/q706f-audio-blank.service
	mkdir -p "$pkgdir"/usr/lib/systemd/user/gnome-session.target.wants
	ln -s ../q706f-audio-blank.service \
		"$pkgdir"/usr/lib/systemd/user/gnome-session.target.wants/q706f-audio-blank.service
}

nonfree_firmware() {
	pkgdesc="Firmware for GPU, WiFi, etc."
	depends="
		firmware-lenovo-q706f-adreno
		firmware-lenovo-q706f-adsp
		firmware-lenovo-q706f-cdsp
		firmware-lenovo-q706f-cirrus
		firmware-lenovo-q706f-hexagonfs
		firmware-lenovo-q706f-slpi
		firmware-lenovo-q706f-venus
		linux-firmware-ath11k
		linux-firmware-qca
		pd-mapper
		tqftpserv
		"
	mkdir "$subpkgdir"
}

nonfree_firmware_openrc() {
	install_if="$pkgname-nonfree-firmware=$pkgver-r$pkgrel openrc"
	depends="openrc"

	mkdir "$subpkgdir"
}

openrc() {
	install_if="$pkgname=$pkgver-r$pkgrel openrc"
	depends="hexagonrpcd-openrc openrc"

	mkdir -p "$subpkgdir"
}


