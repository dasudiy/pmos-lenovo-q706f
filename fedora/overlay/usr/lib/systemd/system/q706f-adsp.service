[Unit]
Description=Boot Q706F ADSP, SLPI, and CDSP remoteprocs
DefaultDependencies=no
After=local-fs.target
Before=sound.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'for name in adsp cdsp slpi; do \
  for d in /sys/class/remoteproc/remoteproc*; do \
    [ "$$(cat "$$d/name" 2>/dev/null)" = "$$name" ] || continue; \
    if [ "$$(cat "$$d/state" 2>/dev/null)" = offline ]; then \
      echo start > "$$d/state" 2>/dev/null || true; \
    fi; \
  done; \
done'

[Install]
WantedBy=multi-user.target
