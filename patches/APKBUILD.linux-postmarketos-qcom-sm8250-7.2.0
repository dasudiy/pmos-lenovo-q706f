# Reference: <https://postmarketos.org/vendorkernel>
# Kernel config based on pmaports main 7.2.0-r0 + kernel-config/q706f-extra.config
# Co-Maintainer: bluebunny <bluebunny@postmarketos.org>
maintainer="Jianhua Lu <lujianhua000@gmail.com>"
_flavor="postmarketos-qcom-sm8250"
pkgname=linux-$_flavor
pkgver=7.2.0
pkgrel=6
pkgdesc="Mainline kernel fork for SM8250"
arch="aarch64"
_carch="arm64"
url="https://gitlab.postmarketos.org/soc/qualcomm-sm8250/linux"
license="GPL-2.0-only"
options="!strip !check !tracedeps
	pmb:cross-native
	pmb:kconfigcheck-nftables
	pmb:kconfigcheck-community
	pmb:kconfigcheck-uefi
"
makedepends="
	bash
	bison
	clang
	elfutils-dev
	findutils
	flex
	linux-headers
	lld
	llvm
	openssl-dev
	pahole
	perl
	postmarketos-installkernel
	python3
"

# 0002 (DP Configure signalling) and 0003 (qmp-combo typec mux) are already
# in sm8250-7.2.0. 0005 still applies: brightness is the old 0x53=0x28 path
# even though probe uses devm_drm_panel_alloc.

# Source
_tag="sm8250-$pkgver"
_config="config-$_flavor.$arch"
source="
	$pkgname-$_tag.tar.gz::https://gitlab.postmarketos.org/soc/qualcomm-sm8250/linux/-/archive/$_tag/linux-$_tag.tar.gz
	$_config
	0001-arm64-dts-qcom-sm8250-lenovo-q706f-vol-up-wakeup.patch
	0004-arm64-dts-qcom-sm8250-lenovo-q706f-4-lane-DP.patch
	0005-drm-panel-samsung-amsa26zp01-fix-brightness-glitch.patch
	0006-drm-msm-dsi-skip-link-clk-set-rate-on-runtime-cmd.patch
	0007-arm64-dts-qcom-sm8250-lenovo-q706f-spi13-cs-gpio.patch
	0008-arm64-dts-qcom-sm8250-lenovo-q706f-disable-unused-pcie2-pon.patch
	0009-arm64-dts-qcom-sm8250-lenovo-q706f-folio-touchpad-probe-delay.patch
	0010-HID-i2c-hid-override-q706f-elan-folio-touchpad-descriptors.patch
	0011-HID-i2c-hid-elan-04f3-31f3-bad-input-size.patch
	0012-arm64-dts-qcom-sm8250-lenovo-q706f-enable-pm8150b-charger.patch
	0013-usb-dwc3-drop-gadget-pullup-on-USB_ROLE_NONE.patch
	0014-usb-dwc3-apply-pullup-while-controller-is-active.patch
	0015-power-bq27xxx-do-not-report-full-while-discharging.patch
	0016-arm64-dts-qcom-sm8250-lenovo-q706f-enable-front-camera-ov8856.patch
	0017-dt-bindings-media-i2c-add-ovti-ov13b10.patch
	0018-media-i2c-ov13b10-add-OF-match-table.patch
	0019-arm64-dts-qcom-sm8250-lenovo-q706f-enable-rear-camera-ov13b10.patch
"
builddir="$srcdir/linux-$_tag"

prepare() {
	default_prepare
	cp "$srcdir/config-$_flavor.$arch" .config
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-$_flavor"
}

package() {
	mkdir -p "$pkgdir"/boot

	if [ -e "$builddir/arch/$_carch/boot/vmlinuz.efi" ]; then
		install -Dm644 "$builddir/arch/$_carch/boot/vmlinuz.efi" \
			"$pkgdir/boot/linux.efi"
		install -Dm644 "$builddir/arch/$_carch/boot/vmlinuz" \
			"$pkgdir/boot/vmlinuz"
	else
		echo "WARNING: CONFIG_ZBOOT not enabled!"
		install -Dm644 "$builddir/arch/$_carch/boot/Image.gz" \
			"$pkgdir/boot/vmlinuz"
	fi

	make modules_install dtbs_install \
		ARCH="$_carch" \
		LLVM=1 \
		INSTALL_PATH="$pkgdir"/boot/ \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir/boot/dtbs"
	rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source

	install -D "$builddir/include/config/kernel.release" \
		"$pkgdir"/usr/share/kernel/$_flavor/kernel.release
}

