From: Asuka <asuka@localhost>
Subject: [PATCH] drm/panel: samsung-amsa26zp01: stop WRCTRLD spam on brightness

Do not rewrite WRCTRLD (0x53) on every backlight tick. Smooth dimming is
already enabled in the panel on-sequence. Skip redundant WRDISBV writes.

Do not set MIPI_DSI_MODE_LPM on this video-mode DSC panel: LP commands
during active video can leave the panel black.

---
 drivers/gpu/drm/panel/panel-samsung-amsa26zp01.c | 12 ++++++++----
 1 file changed, 8 insertions(+), 4 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-samsung-amsa26zp01.c b/drivers/gpu/drm/panel/panel-samsung-amsa26zp01.c
--- a/drivers/gpu/drm/panel/panel-samsung-amsa26zp01.c
+++ b/drivers/gpu/drm/panel/panel-samsung-amsa26zp01.c
@@ -24,6 +24,7 @@
 	struct drm_dsc_config dsc;
 	struct gpio_desc *reset_gpio;
 	struct regulator_bulk_data supplies[2];
+	u16 bl_brightness;
 };
 
 static inline
@@ -171,12 +172,16 @@
 static int samsung_amsa26zp01_bl_update_status(struct backlight_device *bl)
 {
 	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	struct samsung_amsa26zp01 *ctx = mipi_dsi_get_drvdata(dsi);
 	u16 brightness = backlight_get_brightness(bl);
 	int ret;
-	// u8 payload_hbm_on[1] = { 0xE0 };	/* HBM Mode */
-	// u8 payload_hbm_off[1] = { 0x28 }; /* 0x20:Normal mode + Smooth dimming off; 0x28: Normal mode + Smooth dimming on */
-	struct mipi_dsi_multi_context dsi_ctx = { .dsi = dsi };
-	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x53, 0x28);
+
+	if (!ctx->panel.prepared)
+		return 0;
+
+	if (ctx->bl_brightness == brightness)
+		return 0;
+	ctx->bl_brightness = brightness;
 
 	ret = mipi_dsi_dcs_set_display_brightness(dsi, brightness);
 	if (ret < 0)
@@ -231,6 +236,7 @@
 				     "Failed to get reset-gpios\n");
 
 	ctx->dsi = dsi;
+	ctx->bl_brightness = U16_MAX;
 	mipi_dsi_set_drvdata(dsi, ctx);
 
 	dsi->lanes = 4;
