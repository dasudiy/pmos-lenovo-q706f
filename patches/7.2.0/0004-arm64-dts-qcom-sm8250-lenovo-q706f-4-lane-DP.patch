From: Asuka <asuka@localhost>
Subject: [PATCH] arm64: dts: qcom: sm8250-lenovo-q706f: enable 4-lane DP Alt Mode

Allow all four DP lanes on mdss_dp_out and register the QMP combo PHY as
a Type-C mode-switch so pin assignment C can use a full 4-lane link
(needed for 4K60). 7.2.0 already has the qmp-combo mux; this is DTS only.

---
--- a/arch/arm64/boot/dts/qcom/sm8250-lenovo-q706f.dts	2026-10-08 23:49:06.439929077 +0800
+++ b/arch/arm64/boot/dts/qcom/sm8250-lenovo-q706f.dts	2026-10-08 23:49:03.709828311 +0800
@@ -885,7 +885,7 @@
 };
 
 &mdss_dp_out {
-	data-lanes = <0 1>;
+	data-lanes = <0 1 2 3>;
 	remote-endpoint = <&usb_1_qmpphy_dp_in>;
 };
 
@@ -1601,6 +1601,7 @@
 &usb_1_qmpphy {
 	status = "okay";
 
+	mode-switch;
 	vdda-phy-supply = <&vreg_l9a_1p2>;
 	vdda-pll-supply = <&vreg_l18a_0p92>;
 };
