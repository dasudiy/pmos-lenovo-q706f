From: pmOS Q706F fixes
Subject: [PATCH] dt-bindings: media: i2c: add OmniVision OV13B10

OV13B10 is a 13 MP MIPI CSI-2 sensor. The driver already handles the
clock, the reset GPIO and the DOVDD/AVDD/DVDD supplies, but there is no
binding for DT users. Add one, so the Lenovo Q706F rear camera can be
described and checked.

---
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/i2c/ovti,ov13b10.yaml
@@ -0,0 +1,119 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/ovti,ov13b10.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: OmniVision OV13B10 13 MP CMOS Sensor
+
+maintainers:
+  - Sakari Ailus <sakari.ailus@linux.intel.com>
+
+description:
+  The OmniVision OV13B10 is a 13 megapixel 1/3.06-inch CMOS image sensor
+  with a 2 or 4 lane MIPI CSI-2 output, controlled over I2C (SCCB). The
+  driver register tables assume a 19.2 MHz input clock.
+
+allOf:
+  - $ref: /schemas/media/video-interface-devices.yaml#
+
+properties:
+  compatible:
+    const: ovti,ov13b10
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    maxItems: 1
+
+  clock-names:
+    items:
+      - const: xvclk
+
+  dovdd-supply:
+    description: Digital I/O power supply.
+
+  avdd-supply:
+    description: Analog power supply.
+
+  dvdd-supply:
+    description: Digital core power supply.
+
+  reset-gpios:
+    maxItems: 1
+    description: XSHUTDN pin, physically active low.
+
+  orientation: true
+  rotation: true
+
+  port:
+    $ref: /schemas/graph.yaml#/$defs/port-base
+    additionalProperties: false
+
+    properties:
+      endpoint:
+        $ref: /schemas/media/video-interfaces.yaml#
+        unevaluatedProperties: false
+
+        properties:
+          data-lanes:
+            oneOf:
+              - items:
+                  - const: 1
+                  - const: 2
+              - items:
+                  - const: 1
+                  - const: 2
+                  - const: 3
+                  - const: 4
+
+          link-frequencies: true
+
+        required:
+          - data-lanes
+          - link-frequencies
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - dovdd-supply
+  - avdd-supply
+  - dvdd-supply
+  - port
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        camera@36 {
+            compatible = "ovti,ov13b10";
+            reg = <0x36>;
+
+            clocks = <&cam_mclk>;
+
+            reset-gpios = <&gpio 1 GPIO_ACTIVE_LOW>;
+
+            dovdd-supply = <&vreg_1p8>;
+            avdd-supply = <&vreg_2p8>;
+            dvdd-supply = <&vreg_1p2>;
+
+            orientation = <1>;
+
+            port {
+                endpoint {
+                    remote-endpoint = <&csiphy0_ep>;
+                    data-lanes = <1 2 3 4>;
+                    link-frequencies = /bits/ 64 <560000000>;
+                };
+            };
+        };
+    };
+...
