+
+static const struct i2c_hid_desc_override *i2c_hid_of_desc_override(uint8_t *i2c_name)
+{
+	if (of_machine_is_compatible("lenovo,q706f") &&
+	    !strcmp(i2c_name, "9-0060"))
+		return &q706f_elan_ptp_desc;
+	return NULL;
+}
+
 static const struct dmi_system_id i2c_hid_dmi_desc_override_table[] = {
 	{
 		.ident = "Teclast F6 Pro",
@@ -445,6 +524,10 @@
 	struct i2c_hid_desc_override *override;
 	const struct dmi_system_id *system_id;
 
+	override = (struct i2c_hid_desc_override *)i2c_hid_of_desc_override(i2c_name);
+	if (override)
+		return override->i2c_hid_desc;
+
 	system_id = dmi_first_match(i2c_hid_dmi_desc_override_table);
 	if (!system_id)
 		return NULL;
@@ -462,6 +545,12 @@
 	struct i2c_hid_desc_override *override;
 	const struct dmi_system_id *system_id;
 
+	override = (struct i2c_hid_desc_override *)i2c_hid_of_desc_override(i2c_name);
+	if (override) {
+		*size = override->hid_report_desc_size;
+		return override->hid_report_desc;
+	}
+
 	system_id = dmi_first_match(i2c_hid_dmi_desc_override_table);
 	if (!system_id)
 		return NULL;
